---
// src/layouts/Layout.astro
import "@/styles/globals.css";
import Navbar from "@/shared/components/Navigation/Navbar";
import Footer from "@/shared/components/Footer/Footer";
import { I18nProvider } from "@/i18n/I18nProvider";
import { BranchProvider } from "@/features/branches/BranchContext";
import type { Language } from "@/i18n/constants";

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
  lcpImage?: string;
  lcpImageMobile?: string;
}

const {
  title = "My Friend",
  description = "",
  lang = "es",
  lcpImage,
  lcpImageMobile,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/webp" href="/img/mf-logo.webp" />
    <link rel="shortcut icon" type="image/webp" href="/img/mf-logo.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/mf-logo.webp" />
    
    <meta name="theme-color" content="#a91d3a" />
    <meta name="msapplication-TileColor" content="#a91d3a" />
    <meta name="msapplication-TileImage" content="/img/mf-logo.webp" />
    
    {
      lcpImage && (
        <link
          rel="preload"
          as="image"
          href={lcpImage}
          imagesrcset={
            lcpImageMobile
              ? `${lcpImageMobile} 768w, ${lcpImage} 1920w`
              : undefined
          }
          imagesizes="100vw"
        />
      )
    }
    
    <script is:inline>
      (function() {
        if (window.location.hash && window.location.pathname.match(/^\/[a-z]{2}\/?$/)) {
          const hash = window.location.hash;
          
          if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
          }
          
          window.location.hash = '';
          
          setTimeout(() => {
            window.location.hash = hash;
            setTimeout(() => {
              if ('scrollRestoration' in history) {
                history.scrollRestoration = 'auto';
              }
            }, 500);
          }, 100);
        }
      })();
    </script>
  </head>
  <body>
    <I18nProvider lang={lang} client:load>
      <BranchProvider>
        <Navbar client:load />
        <main>
          <slot />
        </main>
        <Footer client:idle />
      </BranchProvider>
    </I18nProvider>
  </body>
</html>