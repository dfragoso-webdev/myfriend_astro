---
// src/features/landing/Landing.astro
import About from "./components/About/About";
import Banner from "./components/Banner/Banner";
import FollowUs from "./components/FollowUs/FollowUs";
import HomeService from "./components/HomeService/HomeService";
import LuxeIslandBand from "./components/LuxeIslandBand/LuxeIslandBand";
import Products from "../products/Products";
import PremiumSelect from "../products/PremiumSelect";
import Stores from "./components/Stores/Stores";
import { video as videoAssets } from "@/mediaRoutes";

interface Props {
  lang: string;
  bannerImages?: { images: string[]; imagesMobile: string[] };
  featuredStores?: Array<{
    id: string;
    name: string;
    nameEn: string;
    image: string;
    city: string;
    cityEn: string;
    citySlug: string;
    slug: string;
    address: string;
    email: string;
    phone: string;
  }>;
  videoSrc?: string;
  bg?: string;
}

const {
  lang,
  bannerImages,
  featuredStores = [],
  videoSrc = videoAssets.myfriend,
  bg = "",
} = Astro.props;
---

<main>
  {/* Asegurar que cada sección tiene un ID único que coincida con los href del navbar */}
  <section id="home">
    <Banner
      images={bannerImages?.images || []}
      imagesMobile={bannerImages?.imagesMobile || []}
      client:load
    />
  </section>

  <section id="about-us">
    <About videoSrc={videoSrc} bg={bg} client:visible />
  </section>

  <section id="stores">
    <Stores lang={lang} client:visible />
  </section>

  <section id="premium-select">
    <PremiumSelect client:idle />
  </section>

  <section id="products">
    <Products client:visible />
  </section>

  <section id="home-service">
    <HomeService client:idle />
  </section>

  <section id="luxe-island">
    <LuxeIslandBand client:idle />
  </section>

  <section id="follow-us">
    <FollowUs client:idle />
  </section>
</main>

<script>
  // Remover el script anterior porque ahora lo manejamos con el hook
  if (window.location.hash) {
    // No hacer nada aquí, el hook se encargará
  }
</script>